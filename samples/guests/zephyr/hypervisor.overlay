&sram0 {
	reg = <0x0 0x40000000 0x0 0x00020000>;
};

&gic {
	status = "okay";
};

&{/timer} {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

&pcie {
	status = "disabled";
};

&{/chosen} {
	/delete-property/ zephyr,flash;
	/delete-property/ zephyr,pcie-controller;
};
